# KontrakanKu Environment Variables Example

# Server Port (Railway will automatically provide PORT)
PORT=3000
NODE_ENV=production

# Database Configuration:
# If you use Railway MySQL, Railway automatically sets DATABASE_URL (or MYSQL_URL).
DATABASE_URL="mysql://root:password@mysql.railway.internal:3306/railway"

# Or configure individual MySQL connection parameters:
# SQL_HOST="localhost"
# SQL_PORT="3306"
# SQL_USER="root"
# SQL_PASSWORD="your_password"
# SQL_DB_NAME="kontrakanku"

# JWT Secret for Authentication
JWT_SECRET="your_jwt_secret_key_here"

# App URL (your production domain on Railway)
APP_URL="https://kontrakanku-production.up.railway.app"
